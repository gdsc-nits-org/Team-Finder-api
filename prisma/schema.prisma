generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_CONNECTION_STRING")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  firebaseId String   @unique
  email      String   @unique
  firstName  String
  middleName String   @default("")
  lastName   String
  username   String   @unique
  imageUrl   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  techStack  String[]


model Thread {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId  
  description    String  
  title          String  
  creatorId      String   @db.ObjectId
  creator        User     @relation(fields: [creatorId], references: [id])
  enrolledUsers  String[] @db.ObjectId  
  writeAccess    String[] @db.ObjectId 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Team {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id])
  skills         String[] @default([])
  enrolledUsers  User[]   @relation("EnrolledTeams", references: [id])
  writeAccess    User[]   @relation("WriteAccessTeams", references: [id])
  maxMembers     Int      @default(5)
}
